# ==========================================
# Colosseum 新仓库 .gitignore
# ==========================================

# === 构建产物 / 依赖（将来新项目会有） ===
node_modules/
dist/
dist-ssr/
.next/
.next-build/
out/
build/
tsconfig.tsbuildinfo
*.db
*.db-journal
*.db-wal
*.db-shm

# === 日志 ===
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# === 环境变量 ===
.env
.env.local
.env.*.local

# === 编辑器 / 系统 ===
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.swp
*.swo

# === 私有 / 本地 ===
*.local
*.local.md
docs/dev/llm-api-config.local.md
temp-init/
.codebuddy/

# === AI 工具本地目录 ===
.mimosa/
.zcode/

# === 临时目录（只保留 .gitkeep 占位） ===
tmp/*
!tmp/.gitkeep

# === 打包产物 ===
*.tar
*.tar.gz
*.zip
